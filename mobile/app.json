{
  "expo": {
    "name": "AntojosGo",
    "slug": "antojosgo-mobile",
    "scheme": "antojosgo",
    "version": "0.7.2",
    "platforms": [
      "android"
    ],
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.antojosgo.mobile",
      "versionCode": 11,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AntojosGo usa tu ubicación para ordenar sedes cercanas. Si la niegas, puedes buscar por municipio o nombre."
        }
      ],
      "expo-build-properties",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F8F7F2"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "AntojosGo usa el micrófono solo mientras buscas por voz.",
          "speechRecognitionPermission": "AntojosGo convierte tu voz en texto para buscar.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-web-browser"
    ],
    "icon": "./assets/icon.png"
  }
}
